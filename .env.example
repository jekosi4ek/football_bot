# Copy this file to .env and fill in your values

# Telegram Bot token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# PostgreSQL connection string — set automatically by Railway when you add the Postgres plugin.
# Leave empty for local development (SQLite will be used instead).
DATABASE_URL=

# SQLite fallback — only used when DATABASE_URL is not set
DATABASE_PATH=football.db

# Default half duration in minutes
DEFAULT_HALF_DURATION=7

# Voice recognition language (uk-UA = Ukrainian, ru-RU = Russian, en-US = English)
SPEECH_LANGUAGE=uk-UA
